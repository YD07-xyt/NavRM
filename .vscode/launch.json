{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROS2 Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/install/fiesta/lib/fiesta/map_node",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build",
      "miDebuggerPath": "/usr/bin/gdb",
      "logging": {
        "moduleLoad": false,
        "trace": true
      }
    }
  ]
}
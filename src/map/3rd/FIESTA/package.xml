<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fiesta</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="xyt15080656916@qq.com">xyt</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>          <!-- ROS2 C++核心库（替代ROS1的roscpp） -->
  <depend>rclpy</depend>           <!-- ROS2 Python核心库（替代ROS1的rospy） -->
  <depend>sensor_msgs</depend>     <!-- 传感器消息类型（与ROS1兼容） -->
  <depend>std_msgs</depend>        <!-- 标准消息类型（与ROS1兼容） -->
  <depend>visualization_msgs</depend> <!-- 可视化消息类型（与ROS1兼容） -->
  <depend>rosidl_default_generators</depend> <!-- ROS2消息生成器（替代ROS1的message_generation） -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
